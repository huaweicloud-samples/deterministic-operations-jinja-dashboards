  title               = "SFS system tier 1 for {{ template_vars['tag_key'] }}: {{ template_vars['tag_value'] }} - Capacity overview"
  view                = "line"
  metric_display_mode = "multiple"
{% if template_vars['sfs'] is defined and template_vars['sfs']['sfs_fs']|length %}
{% for resource in template_vars['sfs']['sfs_fs'] %}
